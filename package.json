{
  "name": "2dbench",
  "version": "0.1.0",
  "private": true,
  "description": "An open, fair benchmark for 2D web renderers: same scenes, same simulation, pixel-parity checked, results with full environment data",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "node run.mjs",
    "dev": "vite",
    "phone": "vite build && vite preview --host --port 4800",
    "typecheck": "tsc --noEmit",
    "pages": "BASE=/2dbench/ vite build"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "spryte": "0.1.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
