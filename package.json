{
  "name": "2dbench",
  "version": "0.1.0",
  "private": true,
  "description": "An open, fair benchmark for 2D web renderers: same scenes, same simulation, pixel-parity checked, results with full environment data",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "node run.mjs",
    "dev": "vite",
    "phone": "vite build && vite preview --host --port 4800",
    "typecheck": "tsc --noEmit",
    "pages": "BASE=/2dbench/ vite build",
    "list": "node run.mjs --list",
    "parity": "node run.mjs rounds=0",
    "charts": "node scripts/charts.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "spryte": "0.4.2"
  },
  "devDependencies": {
    "phaser": "4.2.1",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
